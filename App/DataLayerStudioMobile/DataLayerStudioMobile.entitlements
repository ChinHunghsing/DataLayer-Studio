<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 与 macOS 版共享同一 iCloud KVS 标识，跨 App record 同步布局预设（订阅方案 §3.4）。 -->
